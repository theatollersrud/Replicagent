FROM europe-west4-docker.pkg.dev/agentic-oslo-team-12-9afd/replicagent/dynamic-worker:prototype-2
RUN apt-get update && apt-get install -y --no-install-recommends build-essential curl nodejs npm && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir 'nbclient>=0.10,<1' 'ipykernel>=6,<8' 'scipy>=1.14,<2' 'scikit-learn>=1.5,<2'
COPY replicagent ./replicagent
COPY tests ./tests
RUN python -m pytest -q
CMD ["python", "-m", "replicagent.dynamic_worker"]
